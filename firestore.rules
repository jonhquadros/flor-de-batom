rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * FLORD BATOM MAKEUP - SECURITY RULES
     * 
     * Ajustado para protótipo: Permite leitura de pedidos para usuários logados
     * para facilitar a sincronização entre dispositivos.
     */

    // --- GLOBAL HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      // Para o MVP, qualquer usuário logado que acessa o painel pode ver os dados
      // No futuro, isso deve ser restrito via coleção roles_admin
      return isSignedIn();
    }

    // --- COLLECTION RULES ---

    match /categories/{categoryId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /products/{productId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /orders/{orderId} {
      allow create: if isSignedIn();
      allow get, list: if isSignedIn();
      allow update, delete: if isSignedIn();

      match /orderItems/{orderItemId} {
        allow create: if isSignedIn();
        allow get, list: if isSignedIn();
        allow update, delete: if isSignedIn();
      }
    }

    match /roles_admin/{adminId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create, update, delete: if false; 
    }
  }
}