
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * FLOR DE BATOM MAKEUP - SECURITY RULES
     */

    function isSignedIn() {
      return request.auth != null;
    }

    match /categories/{categoryId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /products/{productId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /orders/{orderId} {
      allow create: if true; 
      allow get, list: if isSignedIn();
      allow update, delete: if isSignedIn();

      match /orderItems/{orderItemId} {
        allow create: if true;
        allow get, list: if isSignedIn();
        allow update, delete: if isSignedIn();
      }
    }

    match /admin_users/{username} {
      allow get, list, create: if true; 
      allow update, delete: if false; 
    }

    match /media/{mediaId} {
      allow get, list: if true;
      allow create, delete: if isSignedIn();
      allow update: if isSignedIn();
    }

    match /metadata/{docId} {
      allow get: if true;
      allow write: if isSignedIn() || true; // Permite criação de contadores iniciais
    }
    
    match /stockMovements/{movementId} {
      allow get, list: if isSignedIn();
      allow create: if true; // Permite que o storefront registre baixas via transação
      allow update, delete: if false;
    }
  }
}
