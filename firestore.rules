rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * FLORD BATOM MAKEUP - SECURITY RULES
     * 
     * DBAC model focusing on admin oversight and public catalog access.
     */

    // --- GLOBAL HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    function isExistingAdmin() {
      return isAdmin() && resource != null;
    }

    // --- COLLECTION RULES ---

    /**
     * @description Rules for Product Categories. Publicly readable. 
     * For MVP/Seeding purposes, any signed-in user can create.
     */
    match /categories/{categoryId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if isExistingAdmin();
    }

    /**
     * @description Rules for Products. Publicly readable.
     * For MVP/Seeding purposes, any signed-in user can create.
     */
    match /products/{productId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if isExistingAdmin();
    }

    /**
     * @description Rules for Customer Orders. Users create; Admins manage/list.
     */
    match /orders/{orderId} {
      allow create: if isSignedIn();
      allow get, list: if isAdmin();
      allow update, delete: if isExistingAdmin();

      match /orderItems/{orderItemId} {
        allow create: if isSignedIn() && request.resource.data.orderId == orderId;
        allow get, list: if isAdmin();
        allow update, delete: if isExistingAdmin();
      }
    }

    /**
     * @description Rules for the Admin Registry.
     */
    match /roles_admin/{adminId} {
      allow get: if isSignedIn() && (isOwner(adminId) || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if false; 
    }
  }
}
