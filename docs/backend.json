
{
  "entities": {
    "Category": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Category",
      "type": "object",
      "description": "Represents a product category, used for organizing and filtering makeup products.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Category entity."
        },
        "name": {
          "type": "string",
          "description": "The name of the product category (e.g., 'Lipsticks', 'Eyeshadows')."
        },
        "description": {
          "type": "string",
          "description": "A brief description of the category, explaining its purpose or content."
        },
        "order": {
          "type": "number",
          "description": "Custom display order for categories."
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when the category was created.",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp when the category was last updated.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "Product": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Product",
      "type": "object",
      "description": "Represents a single makeup product available in the catalog.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Product entity."
        },
        "name": {
          "type": "string",
          "description": "The name of the product."
        },
        "description": {
          "type": "string",
          "description": "A detailed description of the product."
        },
        "price": {
          "type": "number",
          "description": "The selling price of the product."
        },
        "cost": {
          "type": "number",
          "description": "The acquisition cost of the product for billing reports."
        },
        "stock": {
          "type": "number",
          "description": "The total quantity available in inventory."
        },
        "imageUrl": {
          "type": "string",
          "description": "Primary image URL for the product."
        },
        "category": {
          "type": "string",
          "description": "Name of the category this product belongs to."
        },
        "isFeatured": {
          "type": "boolean",
          "description": "Indicates if the product is featured."
        },
        "isActive": {
          "type": "boolean",
          "description": "Indicates if the product is active in the storefront."
        },
        "order": {
          "type": "number",
          "description": "Custom display order for products."
        },
        "variations": {
          "type": "array",
          "description": "Product variations such as colors or sizes with specific stock and images.",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "stock": { "type": "number" },
              "imageUrl": { "type": "string" }
            }
          }
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp when the product was created.",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp when the product was last updated.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "price",
        "category"
      ]
    },
    "Order": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Order",
      "type": "object",
      "description": "Represents a customer's purchase order.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Order entity."
        },
        "orderNumber": {
          "type": "string",
          "description": "Human-readable order number."
        },
        "customerName": {
          "type": "string",
          "description": "The full name of the customer."
        },
        "customerPhone": {
          "type": "string",
          "description": "The phone number of the customer."
        },
        "customerAddress": {
          "type": "string",
          "description": "The delivery address of the customer."
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["Pix", "Dinheiro", "Cartão Débito", "Cartão Crédito"]
        },
        "change": {
          "type": "number",
          "description": "Change needed for cash payments."
        },
        "total": {
          "type": "number",
          "description": "Total order amount."
        },
        "status": {
          "type": "string",
          "enum": ["Pendente", "Pago", "Enviado", "Entregue", "Cancelado"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "customerName",
        "customerPhone",
        "customerAddress",
        "paymentMethod",
        "total",
        "status"
      ]
    },
    "StockMovement": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "StockMovement",
      "type": "object",
      "description": "Records any change in product stock levels.",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "variationName": { "type": "string" },
        "quantity": { "type": "number" },
        "type": { "type": "string", "enum": ["Addition", "Sale", "Loss", "Breakage", "Donation", "Adjustment"] },
        "reason": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "adminId": { "type": "string" }
      },
      "required": ["id", "productId", "quantity", "type", "createdAt"]
    }
  },
  "auth": {
    "providers": [
      "anonymous",
      "password"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/categories/{categoryId}",
        "definition": {
          "entityName": "Category",
          "schema": {
            "$ref": "#/backend/entities/Category"
          },
          "description": "Product categories."
        }
      },
      {
        "path": "/products/{productId}",
        "definition": {
          "entityName": "Product",
          "schema": {
            "$ref": "#/backend/entities/Product"
          },
          "description": "Product catalog."
        }
      },
      {
        "path": "/orders/{orderId}",
        "definition": {
          "entityName": "Order",
          "schema": {
            "$ref": "#/backend/entities/Order"
          },
          "description": "Customer orders."
        }
      },
      {
        "path": "/stockMovements/{movementId}",
        "definition": {
          "entityName": "StockMovement",
          "schema": {
            "$ref": "#/backend/entities/StockMovement"
          },
          "description": "History of stock changes."
        }
      }
    ]
  }
}
